{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["argus", "watchNamespaces", "credentials", "ca", "image", "resources", "networkPolicy", "monitoring"],
  "properties": {
    "hostAliases": {"type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["ip","hostnames"],"properties":{"ip":{"type":"string","anyOf":[{"format":"ipv4"},{"format":"ipv6"}]},"hostnames":{"type":"array","minItems":1,"maxItems":20,"items":{"type":"string","minLength":1,"maxLength":253}}}}},
    "argus": {"type":"object","additionalProperties":false,"required":["endpoint"],"properties":{"endpoint":{"type":"string","pattern":"^https://[A-Za-z0-9.-]+(:[0-9]+)?/api/kubernetes-agent/[A-Za-z0-9-]{1,36}/[a-f0-9]{32}/?$"}}},
    "watchNamespaces": {"type":"array","minItems":1,"maxItems":20,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"}},
    "credentials":{"type":"object","additionalProperties":false,"required":["existingSecret"],"properties":{"existingSecret":{"type":"string","minLength":1,"maxLength":253,"pattern":"^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},"revision":{"type":"string","maxLength":64}}},
    "ca":{"type":"object","additionalProperties":false,"properties":{"existingConfigMap":{"type":"string","maxLength":253,"pattern":"^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}}},
    "monitoring":{"type":"object","additionalProperties":false,"required":["enabled","existingSecret","stateClaim","egress"],"properties":{"enabled":{"type":"boolean"},"existingSecret":{"type":"string","maxLength":253,"pattern":"^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},"stateClaim":{"type":"string","maxLength":253,"pattern":"^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"},"egress":{"type":"array","maxItems":20,"items":{"type":"object","additionalProperties":false,"required":["cidr","port"],"properties":{"cidr":{"type":"string","pattern":"^[0-9a-fA-F.:]+/[0-9]{1,3}$"},"port":{"type":"integer","minimum":1,"maximum":65535}}}}},"allOf":[{"if":{"properties":{"enabled":{"const":true}}},"then":{"properties":{"existingSecret":{"minLength":1},"stateClaim":{"minLength":1},"egress":{"minItems":1}}}}]},
    "image":{"type":"object","additionalProperties":false,"required":["repository","tag","digest","pullPolicy"],"properties":{"repository":{"type":"string","minLength":1},"tag":{"type":"string","minLength":1},"digest":{"type":"string","pattern":"^$|^sha256:[a-f0-9]{64}$"},"pullPolicy":{"enum":["Always","IfNotPresent","Never"]}}},
    "resources":{"type":"object"},
    "networkPolicy":{"type":"object","additionalProperties":false,"required":["enabled","apiServerPort","platformPort"],"properties":{"enabled":{"type":"boolean"},"apiServerPort":{"type":"integer","minimum":1,"maximum":65535},"platformPort":{"type":"integer","minimum":1,"maximum":65535}}}
  }
}
